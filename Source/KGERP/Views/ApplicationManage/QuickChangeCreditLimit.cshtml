@model KGERP.Service.ServiceModel.QuickCreditLimitVm
@{
    ViewBag.Title = "Quick Change Credit Limit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --qc-primary: #3b82f6;
        --qc-primary-dark: #1d4ed8;
        --qc-primary-light: #eff6ff;
        --qc-success: #10b981;
        --qc-success-light: #ecfdf5;
        --qc-gray-50: #f8fafc;
        --qc-gray-100: #f1f5f9;
        --qc-gray-200: #e2e8f0;
        --qc-gray-300: #cbd5e1;
        --qc-gray-500: #64748b;
        --qc-gray-700: #334155;
        --qc-gray-900: #0f172a;
        --qc-radius: 10px;
        --qc-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
    }

    .qc-page-wrapper {
        padding: 15px 0 35px 0;
        font-family: inherit;
    }

    .qc-card {
        background: #ffffff;
        border-radius: var(--qc-radius);
        box-shadow: var(--qc-shadow);
        border: 1px solid var(--qc-gray-200);
        margin-bottom: 25px;
        overflow: hidden;
    }

    .qc-card-header {
        padding: 18px 24px;
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .qc-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .qc-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #60a5fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .qc-header-title h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: #f8fafc;
        letter-spacing: -0.3px;
    }

    .qc-header-title p {
        margin: 3px 0 0;
        font-size: 12.5px;
        color: #94a3b8;
    }

    .qc-header-badge {
        background: rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        border: 1px solid rgba(255, 255, 255, 0.18);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .qc-card-body {
        padding: 22px 24px;
    }

    /* Filter Bar */
    .qc-filter-bar {
        background: var(--qc-gray-50);
        border: 1px solid var(--qc-gray-200);
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .qc-filter-form {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .qc-filter-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--qc-gray-700);
        margin: 0;
    }

    .qc-filter-select {
        height: 38px;
        border-radius: 6px;
        border: 1px solid var(--qc-gray-300);
        padding: 0 12px;
        font-size: 13px;
        min-width: 250px;
        background: #fff;
    }

    .qc-filter-btn {
        height: 38px;
        padding: 0 18px;
        background: var(--qc-primary);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
    }

    .qc-filter-btn:hover {
        background: var(--qc-primary-dark);
        color: #fff;
    }

    /* Table Enhancements */
    #customerCreditTable {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0;
    }

    #customerCreditTable thead th {
        background: #f8fafc;
        color: #334155;
        font-weight: 600;
        font-size: 13px;
        padding: 12px 14px;
        border-bottom: 2px solid #e2e8f0;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    #customerCreditTable tbody tr td {
        padding: 12px 14px;
        vertical-align: middle;
        font-size: 13.5px;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.2s;
    }

    #customerCreditTable tbody tr:hover td {
        background: #f8fafc;
    }

    .qc-code-badge {
        font-family: 'Consolas', monospace;
        font-size: 12.5px;
        font-weight: 600;
        color: #0369a1;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        padding: 4px 8px;
        border-radius: 5px;
        display: inline-block;
    }

    .qc-name-wrap {
        font-weight: 600;
        color: #1e293b;
    }

    .qc-sub-text {
        font-size: 11.5px;
        color: #64748b;
        margin-top: 2px;
    }

    .qc-credit-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
        border-radius: 20px;
        font-weight: 700;
        font-size: 13.5px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .qc-credit-pill:hover {
        background: #dcfce7;
        border-color: #86efac;
        color: #166534;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(22, 101, 52, 0.15);
    }

    .qc-credit-pill i {
        font-size: 11px;
        opacity: 0.7;
    }

    .qc-btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .qc-btn-edit:hover {
        background: #3b82f6;
        color: #ffffff;
        border-color: #3b82f6;
    }

    /* Pulse animation for updated row */
    .qc-row-updated {
        animation: qcPulseGreen 2s ease forwards;
    }

    @@keyframes qcPulseGreen {
        0% { background-color: #bbf7d0; }
        50% { background-color: #dcfce7; }
        100% { background-color: transparent; }
    }

    /* Modal Custom Styling */
    .qc-modal-content {
        border-radius: 12px;
        border: none;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .qc-modal-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: #fff;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .qc-modal-header h4 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #f8fafc;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .qc-modal-header .close {
        color: #fff;
        opacity: 0.8;
        font-size: 24px;
        text-shadow: none;
    }

    .qc-modal-header .close:hover {
        opacity: 1;
    }

    .qc-modal-body {
        padding: 24px;
        background: #ffffff;
    }

    .qc-customer-info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 20px;
    }

    .qc-info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .qc-info-row:last-child {
        margin-bottom: 0;
    }

    .qc-info-label {
        color: #64748b;
        font-weight: 500;
    }

    .qc-info-value {
        color: #1e293b;
        font-weight: 600;
        text-align: right;
    }

    .qc-form-group {
        margin-bottom: 18px;
    }

    .qc-form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .qc-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .qc-currency-symbol {
        position: absolute;
        left: 14px;
        font-size: 15px;
        font-weight: 700;
        color: #64748b;
        pointer-events: none;
    }

    .qc-input-control {
        width: 100%;
        height: 44px;
        padding: 8px 14px 8px 34px;
        border-radius: 8px;
        border: 1.5px solid #cbd5e1;
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .qc-input-control:focus {
        border-color: #3b82f6;
        outline: none;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .qc-modal-footer {
        padding: 14px 22px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .qc-btn-secondary {
        height: 38px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .qc-btn-primary {
        height: 38px;
        padding: 0 20px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

    .qc-btn-primary:hover {
        background: linear-gradient(135deg, #1d4ed8, #1e40af);
        color: #fff;
    }

    .qc-btn-primary:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }
</style>

<div class="qc-page-wrapper">
    <!-- Breadcrumb -->
    <ol class="breadcrumb" style="background: transparent; padding: 0 0 15px 0; margin: 0; font-size: 12px;">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a></li>
        <li><a href="javascript:void(0);">Application Manage</a></li>
        <li class="active">Quick Change Credit Limit</li>
    </ol>

    <!-- Main Card -->
    <div class="qc-card">
        <div class="qc-card-header">
            <div class="qc-header-left">
                <div class="qc-header-icon">
                    <i class="fa fa-credit-card"></i>
                </div>
                <div class="qc-header-title">
                    <h3>Quick Change Credit Limit</h3>
                    <p>Search and instantly update customer credit limits</p>
                </div>
            </div>
            <div>
                <span class="qc-header-badge">
                    <i class="fa fa-users"></i>
                    <span id="lblCustomerCount">@Model.VendorList.Count</span> Customers Listed
                </span>
            </div>
        </div>

        <div class="qc-card-body">
            <!-- Company Filter Bar -->
            @*<div class="qc-filter-bar">
                <form method="get" action="@Url.Action("QuickChangeCreditLimit", "ApplicationManage")" class="qc-filter-form">
                    <label class="qc-filter-label" for="ddlCompany"><i class="fa fa-building-o"></i> Select Company:</label>
                    <select name="companyId" id="ddlCompany" class="qc-filter-select">
                        <option value="0">-- All Active Companies --</option>
                        @if (Model.Companies != null)
                        {
                            foreach (var item in Model.Companies)
                            {
                                <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
                            }
                        }
                    </select>
                    <button type="submit" class="qc-filter-btn">
                        <i class="fa fa-filter"></i> Filter
                    </button>
                </form>
                <div>
                    <span class="text-muted" style="font-size: 12px;">
                        <i class="fa fa-info-circle text-info"></i> Click any <strong>Credit Limit</strong> badge or <strong>Edit</strong> button to modify.
                    </span>
                </div>
            </div>*@

            <!-- Customers DataTable -->
            <div class="table-responsive">
                <table id="customerCreditTable" class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;">#</th>
                            <th style="width: 130px;">Code</th>
                            <th>Customer Name</th>
                            @if (Model.CompanyId == 0)
                            {
                                <th style="width: 140px;">Company</th>
                            }
                            <th style="width: 140px;">Contact / Phone</th>
                            <th style="width: 180px; text-align: right;">Credit Limit</th>
                            <th style="width: 90px; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sl = 1;
                        }
                        @foreach (var item in Model.VendorList)
                        {
                            <tr id="row-vendor-@item.VendorId"
                                data-vendor-id="@item.VendorId"
                                data-code="@item.Code"
                                data-name="@item.Name"
                                data-credit-limit="@(item.CreditLimit ?? 0)">
                                <td style="text-align: center; color: #64748b;">@sl</td>
                                <td>
                                    <span class="qc-code-badge">@item.Code</span>
                                </td>
                                <td>
                                    <div class="qc-name-wrap">@item.Name</div>
                                    @if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <div class="qc-sub-text" title="@item.Address">
                                            <i class="fa fa-map-marker text-danger"></i> @(item.Address.Length > 45 ? item.Address.Substring(0, 45) + "..." : item.Address)
                                        </div>
                                    }
                                </td>
                                @if (Model.CompanyId == 0)
                                {
                                    <td>
                                        <span class="label label-default" style="font-size: 11px;">@item.CompanyName</span>
                                    </td>
                                }
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <span><i class="fa fa-phone text-success"></i> @item.Phone</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 12px;">N/A</span>
                                    }
                                </td>
                                <td style="text-align: right;" data-order="@(item.CreditLimit ?? 0)">
                                    <a href="javascript:void(0);"
                                       class="qc-credit-pill btn-open-modal"
                                       title="Click to change credit limit"
                                       data-vendor-id="@item.VendorId"
                                       data-code="@item.Code"
                                       data-name="@item.Name"
                                       data-credit-limit="@(item.CreditLimit ?? 0)">
                                        <span class="val-credit-limit">@((item.CreditLimit ?? 0).ToString("N2"))</span>
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                </td>
                                <td style="text-align: center;">
                                    <button type="button"
                                            class="qc-btn-edit btn-open-modal"
                                            title="Edit credit limit"
                                            data-vendor-id="@item.VendorId"
                                            data-code="@item.Code"
                                            data-name="@item.Name"
                                            data-credit-limit="@(item.CreditLimit ?? 0)">
                                        <i class="fa fa-edit"></i> Edit
                                    </button>
                                </td>
                            </tr>
                            sl++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Credit Limit -->
<div class="modal fade" id="editCreditLimitModal" tabindex="-1" role="dialog" aria-labelledby="editCreditLimitModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document" style="max-width: 480px; margin-top: 80px;">
        <div class="modal-content qc-modal-content">
            <div class="qc-modal-header">
                <h4 id="editCreditLimitModalLabel">
                    <i class="fa fa-pencil-square-o text-primary"></i> Change Credit Limit
                </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="frmUpdateCreditLimit">
                <input type="hidden" id="modalVendorId" name="vendorId" value="" />

                <div class="qc-modal-body">
                    <!-- Alert message container -->
                    <div id="modalAlertBox" class="alert alert-danger" style="display: none; font-size: 13px; padding: 10px 14px; border-radius: 6px;"></div>

                    <!-- Customer Info Box -->
                    <div class="qc-customer-info-box">
                        <div class="qc-info-row">
                            <span class="qc-info-label">Customer Code:</span>
                            <span class="qc-info-value" id="modalCustomerCode">-</span>
                        </div>
                        <div class="qc-info-row">
                            <span class="qc-info-label">Customer Name:</span>
                            <span class="qc-info-value" id="modalCustomerName">-</span>
                        </div>
                        <div class="qc-info-row" style="margin-top: 6px; padding-top: 6px; border-top: 1px dashed #e2e8f0;">
                            <span class="qc-info-label">Current Credit Limit:</span>
                            <span class="qc-info-value text-success" id="modalCurrentCreditLimit"> 0.00</span>
                        </div>
                    </div>

                    <!-- Credit Limit Input -->
                    <div class="qc-form-group">
                        <label class="qc-form-label" for="modalNewCreditLimit">
                            New Credit Limit <span class="text-danger">*</span>
                        </label>
                        <div class="qc-input-group">
                            <span class="qc-currency-symbol"></span>
                            <input type="number"
                                   id="modalNewCreditLimit"
                                   name="creditLimit"
                                   class="qc-input-control"
                                   placeholder="0.00"
                                   step="0.01"
                                   min="0"
                                   required
                                   autocomplete="off" />
                        </div>
                        <small class="text-muted" style="font-size: 11.5px; margin-top: 4px; display: block;">
                            Enter the revised credit limit amount in BDT.
                        </small>
                    </div>
                </div>

                <div class="qc-modal-footer">
                    <button type="button" class="qc-btn-secondary" data-dismiss="modal">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button type="submit" id="btnSubmitCreditLimit" class="qc-btn-primary">
                        <i class="fa fa-check"></i> Update Credit Limit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Initialize DataTable
            var dataTable = $('#customerCreditTable').DataTable({
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                "ordering": true,
                "responsive": true,
                "language": {
                    "search": "_INPUT_",
                    "searchPlaceholder": "Search customer by code, name, phone...",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ customers",
                    "paginate": {
                        "first": '<i class="fa fa-angle-double-left"></i>',
                        "last": '<i class="fa fa-angle-double-right"></i>',
                        "next": '<i class="fa fa-angle-right"></i>',
                        "previous": '<i class="fa fa-angle-left"></i>'
                    }
                },
                "dom": '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>'
            });

            // Open Modal on Click
            $(document).on('click', '.btn-open-modal', function (e) {
                e.preventDefault();

                var vendorId = $(this).attr('data-vendor-id');
                var code = $(this).attr('data-code');
                var name = $(this).attr('data-name');
                var creditLimit = parseFloat($(this).attr('data-credit-limit')) || 0;

                $('#modalVendorId').val(vendorId);
                $('#modalCustomerCode').text(code);
                $('#modalCustomerName').text(name);
                $('#modalCurrentCreditLimit').text(' ' + creditLimit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#modalNewCreditLimit').val(creditLimit);
                $('#modalAlertBox').hide().text('');

                $('#btnSubmitCreditLimit').prop('disabled', false).html('<i class="fa fa-check"></i> Update Credit Limit');

                $('#editCreditLimitModal').modal('show');
            });

            // Focus on input when modal is shown
            $('#editCreditLimitModal').on('shown.bs.modal', function () {
                $('#modalNewCreditLimit').focus().select();
            });

            // Submit Form via AJAX
            $('#frmUpdateCreditLimit').on('submit', function (e) {
                e.preventDefault();

                var vendorId = $('#modalVendorId').val();
                var newCreditLimit = parseFloat($('#modalNewCreditLimit').val());

                if (!vendorId) {
                    $('#modalAlertBox').text('Invalid customer selected.').show();
                    return;
                }

                if (isNaN(newCreditLimit) || newCreditLimit < 0) {
                    $('#modalAlertBox').text('Please enter a valid non-negative credit limit.').show();
                    return;
                }

                var $btn = $('#btnSubmitCreditLimit');
                $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Updating...');
                $('#modalAlertBox').hide().text('');

                $.ajax({
                    url: '@Url.Action("UpdateCreditLimit", "ApplicationManage")',
                    type: 'POST',
                    data: {
                        vendorId: vendorId,
                        creditLimit: newCreditLimit
                    },
                    dataType: 'json',
                    success: function (response) {
                        if (response && response.success) {
                            var formattedAmount = ' ' + newCreditLimit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                            // Locate the target row
                            var $row = $('#row-vendor-@Model.CompanyId'.length ? $('#row-vendor-' + vendorId) : $('#customerCreditTable tbody tr[data-vendor-id="' + vendorId + '"]'));
                            if (!$row.length) {
                                $row = $('#row-vendor-' + vendorId);
                            }

                            // Update data attributes on row and buttons
                            $row.attr('data-credit-limit', newCreditLimit);
                            $row.find('.btn-open-modal').attr('data-credit-limit', newCreditLimit);

                            // Update text in credit pill
                            $row.find('.val-credit-limit').text(formattedAmount);

                            // Invalidate cell for DataTable sorting/filtering
                            var cell = dataTable.cell($row.find('td:has(.qc-credit-pill)'));
                            if (cell) {
                                $row.find('td:has(.qc-credit-pill)').attr('data-order', newCreditLimit);
                                cell.invalidate();
                            }

                            // Flash animation on row
                            $row.removeClass('qc-row-updated');
                            void $row[0].offsetWidth; // trigger reflow
                            $row.addClass('qc-row-updated');

                            // Hide modal
                            $('#editCreditLimitModal').modal('hide');

                            // Show toast / notification if notify plugin exists, else native alert/banner
                            if (typeof $.notify === 'function') {
                                $.notify({
                                    icon: 'fa fa-check-circle',
                                    message: 'Credit limit for ' + $('#modalCustomerName').text() + ' updated to ' + formattedAmount
                                }, {
                                    type: 'success',
                                    delay: 3500,
                                    placement: { from: "top", align: "right" }
                                });
                            }
                        } else {
                            $btn.prop('disabled', false).html('<i class="fa fa-check"></i> Update Credit Limit');
                            $('#modalAlertBox').text(response ? response.message : 'Update failed. Please try again.').show();
                        }
                    },
                    error: function (xhr, status, error) {
                        $btn.prop('disabled', false).html('<i class="fa fa-check"></i> Update Credit Limit');
                        $('#modalAlertBox').text('Server error occurred: ' + (xhr.statusText || error)).show();
                    }
                });
            });
        });
    </script>
}
