@model KGERP.Services.WareHouse.VMOrderDeliver
@using KGERP.Utility;

@{
    ViewData["Title"] = "Delivery Challan List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int sl = 0;
}
<style type="text/css">

    input, select, textarea {
        max-width: 100%;
    }
</style>
<section class="content-header">
    <h1>
        <span>
            Delivery Confirm List
        </span>
    </h1>
    <ol class="breadcrumb">
        <li><a href="~/Home/Index"><i class="fa fa-dashboard"></i>Dashboard</a></li>
        <li class="active">Delivery Confirm</li>
        <li class="active">
            <a class="btn-link btn btn-primary btn-xs" target="_blank" href="~/WareHouse/WareHouseOrderDeliverDetail?companyId=@Model.CompanyFK">New Deliver</a>

        </li>
    </ol>
</section>
@using (Html.BeginForm("OrderDeliverConfirmShowList", "WareHouse", FormMethod.Post, new { id = "wareHouseOrderDeliverListFormId", @class = "formValidator" }))
{
    <section class="content">
        <div class="row">
            <div class="box">
                <div class="box-danger">
                    <div class="box-header">
                        @Html.HiddenFor(model => model.CompanyFK, new { id = "CompanyId" })
                        <div class="row">
                            <div class="col-md-3">

                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.Label("From Date", htmlAttributes: new { @class = "control-label" })
                                    <br />
                                    @Html.EditorFor(model => model.StrFromDate, new { htmlAttributes = new { @class = "datepicker", @autocomplete = "off" } })
                                    @Html.ValidationMessageFor(model => model.StrFromDate, "", new { @class = "text-danger" })
                                </div>

                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.Label("To Date", htmlAttributes: new { @class = "control-label" })
                                    <br />
                                    @Html.EditorFor(model => model.StrToDate, new { htmlAttributes = new { @class = "datepicker", @autocomplete = "off" } })
                                    @Html.ValidationMessageFor(model => model.StrToDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3" style="padding: 0px 2px 0px 8px;">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <button type="submit" id="btnSave" class="btn btn-primary btn-block">Show</button>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="table-responsive col-md-12  text-nowrap">
                            <table id="KgErpDataTable" class="table table-striped" width="100%">
                                <thead>
                                    <tr>
                                        <th>SL</th>
                                        <th>Challan NO</th>
                                        <th>Invoice No</th>
                                        <th>Delivery Date</th>
                                        <th>Order No</th>
                                        <th>Order Date</th>

                                        <th>Customer</th>
                                        <th>Phone No</th>
                                        <th>Status</th>
                                        @*<th class="text-center">Action</th>*@

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.DataList)
                                    {


                                        <tr>
                                            <th>@(++sl)</th>
                                            <td>

                                                <a href="@Url.Action("GetDeliveryChallanReport","Report", new {orderDeliverId=item.OrderDeliverId,companyId=item.CompanyFK})" title="Challan Copy" target="_blank"> @item.ChallanNo </a>


                                            </td>
                                            <td>@item.InvoiceNo</td>

                                            <td>@item.DeliveryDate.Value.ToString("dd-MM-yyyy")</td>
                                            <td>@item.OrderNo</td>
                                            <td>@item.OrderDate.ToString("dd-MM-yyyy")</td>
                                            <td>@item.CustomerName</td>
                                            <td>@item.CustomerPhone</td>
                                            <td>
                                                @if (item.IsDelivered.HasValue && item.IsDelivered == 1)
                                                {
                                                    <span class="btn btn-success btn-xs">Delivered</span>
                                                }
                                                else
                                                {
                                                    <span class="btn btn-info btn-xs">Pending</span>
                                                }
                                            </td>
                                            @*<td class="text-center">
                                                @if (item.IsDelivered.HasValue && item.IsDelivered == 1)
                                                {
                                                    <span class="btn btn-success btn-xs">OTP Success</span>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary btn-xs" type="button" onclick="OtpSubmit('@item.OrderDeliverId');">OTP Push</button>
                                                    if (item.IsAdmin)
                                                    {
                                                        <span>&nbsp;</span>
                                                        <button class="btn btn-warning btn-xs" type="button" onclick="OtpReSend('@item.OrderDeliverId');">OTP Resend</button>
                                                    }

                                                }

                                                &nbsp;
                                                <a href="~/WareHouse/WareHouseOrderDeliverDetail?companyId=@item.CompanyFK&orderDeliverId=@item.OrderDeliverId" title="Details"><i class="glyphicon glyphicon-new-window"></i></a>

                                            </td>*@


                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="box-footer">
                    </div>
                </div>
            </div>
        </div>
    </section>
}

