@*
    Tiny script for "Select All" checkbox toggle on the admin permission screen.
    Include via: @Html.Partial("_ActionPermissionScripts")
*@
<script type="text/javascript">
    // "Select All" checkbox toggles all four action checkboxes
    var selectAll = document.getElementById('chkSelectAll');
    if (selectAll) {
        var actionBoxes = document.querySelectorAll('.action-permission-checkbox');
        selectAll.addEventListener('change', function () {
            for (var i = 0; i < actionBoxes.length; i++) {
                actionBoxes[i].checked = selectAll.checked;
            }
        });
        // Uncheck "Select All" if any individual box is unchecked
        for (var j = 0; j < actionBoxes.length; j++) {
            actionBoxes[j].addEventListener('change', function () {
                var allChecked = true;
                for (var k = 0; k < actionBoxes.length; k++) {
                    if (!actionBoxes[k].checked) { allChecked = false; break; }
                }
                selectAll.checked = allChecked;
            });
        }
    }
</script>

